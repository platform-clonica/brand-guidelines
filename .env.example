# Supabase — Deck Maker persistence + team login (project "brand-guidelines", org Interactius, eu-central-2)
# Copy to .env.local and fill with the project's API credentials (Supabase dashboard → Project Settings → API).
# In production, set these as Netlify environment variables.
# Auth: se entra a /workspace con la cuenta de Google de Interactius. NO hay que crear usuarios a
# mano: el alta es automática al entrar por primera vez, y el hook before-user-created rechaza
# cualquier email que no sea @interactius.com.
#   ⚠ La BAJA sí es manual. Suspender a alguien en Google Admin NO le cierra la sesión: Supabase no
#     revalida contra Google y sus refresh tokens no caducan. Hay que borrar o banear su fila en
#     Supabase → Auth → Users. Ver docs/features/workspace-login-google.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude API — used by /api/translate (deck + form translation) and /api/rewrite (ReWrit_r,
# the copy rewriter at /workspace/rewrit_r). Server-side only; never exposed.
ANTHROPIC_API_KEY=

# Resend — best-effort "aviso automático" email when a client signs a deck (/api/sign).
# All optional: without them the signature is still persisted, just no email is sent.
RESEND_API_KEY=
INTERACTIUS_NOTIFY_EMAIL=        # recipient(s) of the notice; comma-separated
RESEND_FROM=                     # verified sender, e.g. "Interactius <propuestas@interactius.com>"

# Interactius Forms — reuses THIS Supabase project (the deck's) via the vars above.
# Public forms live under /forms; responses land in the `responses` table (RLS: anon INSERT only,
# team members SELECT via their deck session for the CSV export). No extra keys needed.
